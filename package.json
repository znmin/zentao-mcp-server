{
  "name": "@znmin/zentao-mcp-server",
  "version": "1.1.0",
  "description": "ZenTao MCP server with preset scope, bug workflows and verified REST v2 attachment uploads",
  "type": "module",
  "bin": { "zentao-mcp-server": "bin/zentao-mcp-server.js" },
  "files": ["src/", "bin/", "README.md", "LICENSE", "CHANGELOG.md", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/client.test.js test/mcp.test.js",
    "lint": "node --check src/index.js && node --check src/zentao.js && node --check src/attachments.js && node --check src/comments.js",
    "prepublishOnly": "npm run lint && npm test"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "1.32.2" },
  "repository": { "type": "git", "url": "git+https://github.com/znmin/zentao-mcp-server.git" },
  "homepage": "https://github.com/znmin/zentao-mcp-server#readme",
  "bugs": { "url": "https://github.com/znmin/zentao-mcp-server/issues" },
  "author": "znmin",
  "license": "MIT",
  "keywords": ["zentao", "mcp", "bug-tracking"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
